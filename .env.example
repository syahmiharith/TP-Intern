GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional different Gemini model for proven model-specific daily exhaustion. Empty disables it.
GEMINI_FALLBACK_MODEL=

# Private live-extraction pilot. Generate credentials outside the repository.
PILOT_SESSION_SECRET=
# JSON array of {hash, expiresAt, maxCalls}; never use plaintext invite codes here.
PILOT_INVITE_HASHES=
# Set false and redeploy to disable live extraction while keeping samples available.
LIVE_EXTRACTION_ENABLED=true
